# Core
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/vyva
JWT_SECRET=replace-with-a-long-random-secret

# Supabase auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MEDISEARCH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_BRAIN_TTS_VOICE_ID=
ELEVENLABS_COMPANION_AGENT_ID=
ELEVENLABS_SAFETY_AGENT_ID=
ELEVENLABS_MEDS_AGENT_ID=
ELEVENLABS_HEALTH_AGENT_ID=
ELEVENLABS_CONCIERGE_AGENT_ID=
ELEVENLABS_BRAIN_COACH_AGENT_ID=
MEM0_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5000
VITE_PUBLIC_APP_URL=https://v2.vyva.life
STRIPE_PREMIUM_PRICE_ID=
# Optional per-plan Stripe price IDs can also be stored in the admin Plans & Tiers screen.

# Admin/API integrations
SUPER_ADMIN_EMAIL=karim.assad@mokadigital.net
VITE_SUPER_ADMIN_EMAIL=karim.assad@mokadigital.net
GOOGLE_PLACES_API_KEY=
SENDGRID_API_KEY=
# Must match a verified SendGrid Sender Identity.
NOTIFY_FROM_EMAIL=verified-sender@example.com
# Optional reply-to shown when recipients reply to VYVA emails.
NOTIFY_REPLY_TO_EMAIL=
# Optional aliases supported by email helpers.
SENDGRID_FROM_EMAIL=
EMAIL_FROM=

# Communications dispatcher
# Set COMMUNICATION_DISPATCH_INTERVAL_MS to enable automatic queue draining.
COMMUNICATION_DISPATCH_INTERVAL_MS=
COMMUNICATION_DISPATCH_BATCH_SIZE=25
CONSENT_MAX_ATTEMPTS=3
CONSENT_RETRY_DELAYS_MINUTES=30,120
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Preferred direct SMS sender. Set this to the US SMS-capable Twilio number.
TWILIO_US_SMS_FROM_NUMBER=
TWILIO_SMS_MESSAGING_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM_NUMBER=
TWILIO_CONSENT_CALL_URL=
# Optional public HTTPS base used for Twilio delivery and voice callbacks.
# Leave blank for local development; local sends will skip callbacks.
TWILIO_WEBHOOK_BASE_URL=https://v2.vyva.life
